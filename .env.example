# Settings for the Docker dev stack (compose.yaml). Copy this file to .env
# (git ignores it) and uncomment what you need; docker compose reads .env
# by itself. Every value shown is the default. See "Develop with Docker" in
# the README.
#
#   cp .env.example .env

# Where the Dashboard and app proxy ports listen. 127.0.0.1 is this machine
# only. On a VPS, set 0.0.0.0 to open the Dashboard from a browser
# elsewhere, then allow the ports in your provider's firewall (ideally from
# your own IP only): Docker's published ports bypass ufw.
#PANTALAN_DEV_BIND=127.0.0.1

# The host name or IP printed in the startup URLs. On a VPS, its public IP.
#PANTALAN_DEV_HOST=localhost

# The ports the Dashboard (HTTPS) and the app proxy (HTTP) are published on.
#PANTALAN_DEV_DASHBOARD_PORT=8443
#PANTALAN_DEV_PROXY_PORT=8080

# The port the Dashboard SPA's dev server (HTTPS, hot reload) is published on.
#PANTALAN_DEV_WEB_PORT=5173

# The Admin's username, used only when the stack's data is fresh: an
# existing Admin is never replaced (docker compose down -v starts over).
#PANTALAN_DEV_ADMIN=dev
